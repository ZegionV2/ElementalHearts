<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>EH_AdamantUniform</defName>
    <label>adamant royal regalia</label>
    <description>Indestructible helmetless white-and-gold regal Earth vestments, with a low collar, compact cloak, amber fault seams and fitted full-body coverage. Directional offsets are baked into the seven native body textures.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/AdamantRegalia/AdamantRegalia</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <WorkToMake>3500</WorkToMake>
      <Mass>1.2</Mass>
      <ArmorRating_Sharp>1.1</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.0</ArmorRating_Blunt>
      <Insulation_Cold>5</Insulation_Cold>
      <Insulation_Heat>3</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Hands</li>
        <li>Waist</li>
        <li>Legs</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/AdamantRegalia/AdamantRegalia</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags Inherit="False">
      </tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <generateCommonality>0</generateCommonality>
    <equippedStatOffsets>
      <MoveSpeed>0.15</MoveSpeed>
    </equippedStatOffsets>
    <modExtensions>
      <li Class="ElementalHearts.IndestructibleElementalGear" />
    </modExtensions>
    <useHitPoints>false</useHitPoints>
    <comps>
      <li Class="ElementalHearts.CompProperties_IndestructibleGear" />
    </comps>
    <smeltable>false</smeltable>
    <recipeMaker IsNull="True" />
  </ThingDef>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>EH_AdamantSword</defName>
    <label>Worldbreaker</label>
    <description>Indestructible bound adamant blade with ivory bevels, an amber core and a native Melee Animation grip/blade profile.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/AdamantSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <costStuffCount>100</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <statBases>
      <WorkToMake>18000</WorkToMake>
      <Mass>2</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <equippedAngleOffset>0</equippedAngleOffset>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
    </tools>
    <modExtensions>
      <li Class="ElementalHearts.IndestructibleElementalGear" />
    </modExtensions>
    <useHitPoints>false</useHitPoints>
    <comps>
      <li Class="ElementalHearts.CompProperties_IndestructibleGear" />
    </comps>
    <smeltable>false</smeltable>
    <recipeMaker IsNull="True" />
  </ThingDef>
</Defs>
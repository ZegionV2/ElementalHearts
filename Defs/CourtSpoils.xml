 <ThingDef Name="EH_ElementalEssenceBase" ParentName="ResourceBase" Abstract="True">
  <description>Crystallized elemental power released by a fallen hostile Court warrior. At a drug lab after Fabrication, combine eight matching essence, two industrial medicine and one industrial component to condense one elemental ascension serum. An essence is a crafting material; carrying it grants no powers.</description>
  <stackLimit>75</stackLimit><tradeability>Sellable</tradeability><thingCategories><li>EH_ElementalMaterials</li></thingCategories>
  <graphicData><texPath>Things/Item/ElementalHearts/ElementalEssence</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.65</drawSize></graphicData>
  <statBases><MarketValue>100</MarketValue><Mass>0.08</Mass><MaxHitPoints>100</MaxHitPoints><DeteriorationRate>0</DeteriorationRate><Flammability>0</Flammability></statBases>
 </ThingDef>

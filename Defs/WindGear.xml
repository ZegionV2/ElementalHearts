<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>EH_WindUniform</defName>
    <label>wind uniform</label>
    <description>A closed wind uniform covering the torso, shoulders, arms, hands, waist, legs and feet. Cosmetic elemental styling; no special powers. Indestructible elemental equipment: cannot be damaged or worn out.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/WindUniform/WindUniform</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <costList>
      <Cloth>60</Cloth>
      <Steel>20</Steel>
    </costList>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <WorkToMake>3500</WorkToMake>
      <Mass>1.2</Mass>
      <ArmorRating_Sharp>0.65</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <Insulation_Cold>5</Insulation_Cold>
      <Insulation_Heat>3</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Hands</li>
        <li>Waist</li>
        <li>Legs</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/WindUniform/WindUniform</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags Inherit="False">
      </tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>ComplexClothing</researchPrerequisite>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
    </recipeMaker>
    <generateCommonality>0</generateCommonality>
    <equippedStatOffsets>
      <MoveSpeed>0.4</MoveSpeed>
    </equippedStatOffsets>
    <modExtensions>
      <li Class="ElementalHearts.IndestructibleElementalGear" />
    </modExtensions>
    <useHitPoints>false</useHitPoints>
    <comps>
      <li Class="ElementalHearts.CompProperties_IndestructibleGear" />
    </comps>
    <smeltable>false</smeltable>
  </ThingDef>
  <HairDef>
    <defName>EH_WindHair</defName>
    <label>wind hair</label>
    <texPath>Things/Pawn/Humanlike/Hair/WindHair</texPath>
    <styleGender>Any</styleGender>
    <styleTags Inherit="False">
    </styleTags>
  </HairDef>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>EH_WindSword</defName>
    <label>wind katana</label>
    <description>A pale jade-edged katana balanced for quick cuts. Wind Ascendant techniques scale with its melee attacks. Indestructible elemental equipment: cannot be damaged or worn out.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/WindSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <costStuffCount>100</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <statBases>
      <WorkToMake>18000</WorkToMake>
      <Mass>2</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <equippedAngleOffset>0</equippedAngleOffset>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <researchPrerequisite>LongBlades</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
    <modExtensions>
      <li Class="ElementalHearts.IndestructibleElementalGear" />
    </modExtensions>
    <useHitPoints>false</useHitPoints>
    <comps>
      <li Class="ElementalHearts.CompProperties_IndestructibleGear" />
    </comps>
    <smeltable>false</smeltable>
  </ThingDef>
</Defs>
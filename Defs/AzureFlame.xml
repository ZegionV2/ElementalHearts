<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>EH_AzureFlameUniform</defName>
    <label>azure royal regalia</label>
    <description>Manifested ivory royal Azure Flame regalia with a short white cloak, tucked shoulders, gold trim and blue flame accents. Compact low neckline; no sleeves or helmet. Bound to its ascendant. Indestructible elemental equipment: cannot be damaged or worn out. Closed opaque lining covers shoulders, upper back and the torso down to the hem in every direction; compact neckline with no drawn neck or limbs.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/AzureFlameRegalia/AzureFlameRegalia</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <WorkToMake>3500</WorkToMake>
      <Mass>1.2</Mass>
      <ArmorRating_Sharp>0.65</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <Insulation_Cold>5</Insulation_Cold>
      <Insulation_Heat>3</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <apparel>
      <drawData>
        <dataSouth>
          <offset>(0, 0, 0)</offset>
        </dataSouth>
        <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
      </drawData>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Waist</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/AzureFlameRegalia/AzureFlameRegalia</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags Inherit="False">

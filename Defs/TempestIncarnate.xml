  <HediffDef ParentName="EH_ElementalHeartHediffBase">
    <defName>EH_TempestIncarnate</defName>
    <label>Tempest Incarnate</label>
    <description>Tempest Incarnate: Wind’s third form, after Cyclone. Celestial-tier power: 650% Moving, 200% Consciousness, 300% Manipulation, 250% Sight/Hearing, +75 mood, 3.2x melee stat, 0.04 incoming damage, rapid recovery, 15x carrying capacity and 4x caravan speed. Disperses 65% of remaining bomb damage and reduces electrical shock chance/duration by 75%. Seven free techniques combine checked dashes, pressure crescents, a spin, a guarded mirage counter, three timed rising/descending cuts, a bounded airhold/release and a grand localized storm funnel. Storm Flow empowers finishers without extra damage ticks. Shared Auto/Off/Non-lethal; no permanent terrain, building, weather or roof changes. Indestructible full below-neck dark suit/cape and Skyrend katana; cloud halo/back aura only while transformed, drafted and awake. Bestow grants ordinary Wind. Right-click utility cycles Cloud Step Auto, Manual, Tempest Travel. World travel is free and supports exact landing. Damage scales from the current melee profile; the shared 20% reduction applies once.</description>
    <comps>
      <li Class="ElementalHearts.HediffCompProperties_WindAbilities">
        <drawRange>12</drawRange>
        <tempestRange>8</tempestRange>
        <guardRange>5</guardRange>
        <drawDamage>3.2</drawDamage>
        <riseFirstDamage>1.8</riseFirstDamage>
        <riseSecondDamage>2</riseSecondDamage>
        <counterDamage>3.8</counterDamage>
        <counterSweepDamage>1.5</counterSweepDamage>
        <tempestOpeningDamage>2.4</tempestOpeningDamage>
        <tempestSecondDamage>2.4</tempestSecondDamage>
        <tempestFinishDamage>4</tempestFinishDamage>
        <armorPenetrationFloor>0.5</armorPenetrationFloor>
        <staggerTicks>60</staggerTicks>
        <drawCooldown>210</drawCooldown>
        <riseCooldown>270</riseCooldown>
        <counterCooldown>360</counterCooldown>
        <tempestCooldown>840</tempestCooldown>
        <flowDuration>480</flowDuration>
        <guardDuration>150</guardDuration>
      </li>
      <li Class="ElementalHearts.HediffCompProperties_FlameRecovery">
        <sealAfterTicks>60</sealAfterTicks>
        <healPerSecond>4</healPerSecond>
      </li>
      <li Class="ElementalHearts.HediffCompProperties_TempestMastery" />
      <li Class="ElementalHearts.HediffCompProperties_TempestIncarnate" />
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>5.5</offset>
            <setMax>6.5</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>1.5</offset>
            <setMax>3</setMax>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>1.5</offset>
          </li>
          <li>
            <capacity>Hearing</capacity>
            <offset>1.5</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>1</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>1</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>1</offset>
          </li>
          <li>
            <capacity>Metabolism</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Eating</capacity>
            <offset>0.5</offset>
          </li>
        </capMods>
        <painFactor>0</painFactor>
        <totalBleedFactor>0.1</totalBleedFactor>
        <naturalHealingFactor>10</naturalHealingFactor>
        <hungerRateFactor>0.6</hungerRateFactor>
        <restFallFactor>0.6</restFallFactor>
        <statFactors>
          <CarryingCapacity>15</CarryingCapacity>
          <MoveSpeed>1.75</MoveSpeed>
          <MeleeDamageFactor>3.2</MeleeDamageFactor>
          <MeleeCooldownFactor>0.55</MeleeCooldownFactor>

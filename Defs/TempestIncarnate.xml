<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>EH_TempestIncarnateUniform</defName>
    <label>tempest incarnate princely suit</label>
    <description>Indestructible bound dark grey suit and tailored storm cape, minimal white lightning channels. Complete mechanical coverage below the neck, including hands, legs, feet and groin.</description>

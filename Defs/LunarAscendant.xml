<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <HediffDef ParentName="EH_ElementalHeartHediffBase">
    <defName>EH_LunarHeart</defName>
    <label>Lunar Ascendant</label>
    <description>A rare Lunar Ascendant manipulates gravity through five moonlit techniques. Manifest an indigo cloak, silver crescent armor, a lunar mask and the Moonwake sword. Celestial Bestow can grant this lineage and records readiness for the planned Eclipse evolution.</description>
    <comps>
      <li Class="ElementalHearts.HediffCompProperties_LunarAbilities" />
      <li Class="ElementalHearts.HediffCompProperties_FlameRecovery">
        <sealAfterTicks>180</sealAfterTicks>
        <healPerSecond>2</healPerSecond>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.2</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Hearing</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Metabolism</capacity>
            <offset>0.25</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>0.25</offset>
          </li>
          <li>
            <capacity>Eating</capacity>
            <offset>0.25</offset>
          </li>
        </capMods>
        <painFactor>0</painFactor>
        <totalBleedFactor>0.25</totalBleedFactor>
        <naturalHealingFactor>6</naturalHealingFactor>
        <hungerRateFactor>0.6</hungerRateFactor>
        <restFallFactor>0.6</restFallFactor>
        <statFactors>
          <CarryingCapacity>5</CarryingCapacity>
          <MoveSpeed>1.55</MoveSpeed>
          <MeleeDamageFactor>2</MeleeDamageFactor>
          <MeleeCooldownFactor>0.85</MeleeCooldownFactor>
          <WorkSpeedGlobal>1.75</WorkSpeedGlobal>
          <IncomingDamageFactor>0.55</IncomingDamageFactor>
          <ImmunityGainSpeed>2</ImmunityGainSpeed>
          <JoyFallRateFactor>0.6</JoyFallRateFactor>
        </statFactors>
        <statOffsets>
          <MentalBreakThreshold>-0.25</MentalBreakThreshold>
          <MeleeHitChance>4</MeleeHitChance>
          <MeleeDodgeChance>12</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <JobDef>
    <defName>EH_LunarTechnique</defName>
    <driverClass>ElementalHearts.JobDriver_LunarTechnique</driverClass>
    <reportString>performing a Lunar technique.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <suspendable>false</suspendable>
  </JobDef>
  <HediffDef>
    <defName>EH_LunarMoonveil</defName>
    <label>Moonveil</label>
    <description>Moonlight reduces incoming ranged weapon damage by 30%.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>240</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
  <ThoughtDef>
    <defName>EH_LunarSerenity</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>EH_LunarHeart</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>lunar serenity</label>
        <description>The quiet gravity of the moon steadies my mind.</description>
        <baseMoodEffect>30</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
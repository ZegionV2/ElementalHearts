<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>EH_LunarUniform</defName>
    <label>lunar crescent armor</label>
    <description>Moon-silver plates with mother-of-pearl inlay and an embroidered indigo cloak. Bound to a Lunar Ascendant.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/LunarUniform/LunarUniform</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>

<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="EH_CourtDecorationBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <canOverlapZones>true</canOverlapZones>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>12</Mass>
      <Beauty>8</Beauty>
      <Flammability>0</Flammability>
      <MarketValue>0</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <claimable>false</claimable>
      <alwaysDeconstructible>false</alwaysDeconstructible>
    </building>
  </ThingDef>
  <ThingDef ParentName="EH_CourtDecorationBase">
    <defName>EH_CourtStandard</defName>
    <label>Court war standard</label>
    <description>An ivory, obsidian and crimson furnishing of the Severed Court. The broken crown marks its command halls and fortified gates.</description>
    <graphicData>
      <texPath>Things/Building/SeveredCourt/CourtStandard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5, 2)</drawSize>
      <drawOffset>(0, 0, 0.35)</drawOffset>
      <shaderType>Cutout</shaderType>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
  </ThingDef>
  <ThingDef ParentName="EH_CourtDecorationBase">
    <defName>EH_CourtBrazier</defName>
    <label>Court oath brazier</label>
    <description>An ivory, obsidian and crimson furnishing of the Severed Court. A contained oath-flame lights the fortress without a fuel supply or temperature simulation.</description>
    <graphicData>
      <texPath>Things/Building/SeveredCourt/CourtBrazier</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.25, 1.25)</drawSize>
      <drawOffset>(0, 0, 0.1)</drawOffset>
      <shaderType>Cutout</shaderType>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(235, 170, 100, 0)</glowColor>
      </li>
    </comps>
  </ThingDef>
  <ThingDef Name="EH_CourtFloorInlayBase" ParentName="EH_CourtDecorationBase" Abstract="True">
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <selectable>false</selectable>
    <drawerType>MapMeshOnly</drawerType>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

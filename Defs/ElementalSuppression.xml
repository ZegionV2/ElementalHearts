<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <HediffDef>
    <defName>EH_ElementalSuppression</defName>
    <label>elemental suppression</label>
    <description>Restrained elemental force has temporarily incapacitated this pawn without causing wounds. Wears off after 30 seconds. Existing injuries and other attacks can still be dangerous.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>incapacitated</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.2</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
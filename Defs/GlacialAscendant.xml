  <JobDef>
    <defName>EH_EvolveGlacial</defName>
    <driverClass>ElementalHearts.JobDriver_EvolveAzure</driverClass>
    <reportString>evolving into a Glacial Ascendant.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>
  <HediffDef>
    <defName>EH_GlacialFrozen</defName>
    <label>glacial freeze</label>
    <description>Frozen by Glacial Explosion. Movement and attacks stop for five seconds after a short safe push. Icy-blue tint ends on thaw; brief refreeze immunity follows. Hypothermia recovers normally.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="ElementalHearts.HediffCompProperties_GlacialFrozen" />
    </comps>
  </HediffDef>

  <RecipeDef ParentName="EH_InstallElementalHeartBase">
    <defName>EH_InstallFlameHeart</defName>
    <label>administer flame ascension serum</label>
    <description>Inject one dose of flame ascension serum, granting whole-body ascension without organ surgery. Only one element per pawn.</description>
    <jobString>Injecting flame ascension serum.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EH_FlameHeart</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EH_FlameHeart</li>
      </thingDefs>
    </fixedIngredientFilter>
    <addsHediff>EH_FlameHeart</addsHediff>
  </RecipeDef>
  <RecipeDef ParentName="EH_RemoveElementalHeartBase">
    <defName>EH_RemoveFlameHeart</defName>
    <label>obsolete flame extraction</label>
    <description>Legacy save compatibility only. Ascension is a whole-body condition and cannot be extracted as an item.</description>
    <jobString>Cancelling obsolete extraction.</jobString>
    <removesHediff>EH_FlameHeart</removesHediff>
  </RecipeDef>
  <ThoughtDef>
    <defName>EH_FlameResolve</defName>
    <workerClass>ElementalHearts.ThoughtWorker_FlameResolve</workerClass>
    <hediff>EH_FlameHeart</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>Furnace Resolve</label>
        <description>The furnace within steadies my mind. I feel powerful and composed.</description>
        <baseMoodEffect>30</baseMoodEffect>
      </li>
      <li>
        <label>Azure Sovereignty</label>
        <description>My azure flame burns with sovereign strength and purpose.</description>
        <baseMoodEffect>50</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>

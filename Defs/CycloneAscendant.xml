        <tempestRange>8</tempestRange>
        <guardRange>5</guardRange>
        <drawDamage>3.2</drawDamage>
        <riseFirstDamage>1.8</riseFirstDamage>
        <riseSecondDamage>2</riseSecondDamage>
        <counterDamage>3.8</counterDamage>
        <counterSweepDamage>1.5</counterSweepDamage>
        <tempestOpeningDamage>2.4</tempestOpeningDamage>
        <tempestSecondDamage>2.4</tempestSecondDamage>
        <tempestFinishDamage>4</tempestFinishDamage>
        <armorPenetrationFloor>0.5</armorPenetrationFloor>
        <staggerTicks>60</staggerTicks>
        <drawCooldown>210</drawCooldown>
        <riseCooldown>270</riseCooldown>
        <counterCooldown>360</counterCooldown>
        <tempestCooldown>840</tempestCooldown>
        <flowDuration>480</flowDuration>

          <MeleeDodgeChance>12</MeleeDodgeChance>

          <ComfyTemperatureMax>50</ComfyTemperatureMax>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <JobDef>
    <defName>EH_EvolveThunderstorm</defName>
    <driverClass>ElementalHearts.JobDriver_EvolveAzure</driverClass>
    <reportString>Evolving into a Thunderstorm Ascendant.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>
  <DamageDef ParentName="Flame">
    <defName>EH_ThunderstormDamage</defName>
    <label>crimson lightning</label>
    <description>Crimson electrical injury from Thunderstorm techniques. Some attacks also deal a separate physical sword hit. Damaging electrical hits can trigger Thunderstorm's shock status. The common elemental balance applies a 20% reduction to this injury packet before the target's mitigation; trails and afterimages are visual effects.</description>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <deathMessage>{0} was struck down by crimson lightning.</deathMessage>
    <impactSoundType>Electric</impactSoundType>
    <scaleDamageToBuildingsBasedOnFlammability>false</scaleDamageToBuildingsBasedOnFlammability>
    <modExtensions>
      <li Class="ElementalHearts.ElectricalDamageExtension" />
    </modExtensions>
  </DamageDef>
  <HediffDef>
    <defName>EH_ThunderstormSlow</defName>
    <label>redline stagger</label>
    <description>Briefly slowed by a Thunderstorm strike.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.7</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>

  <HediffDef ParentName="EH_ElementalHeartHediffBase">
    <defName>EH_ThunderstormAscendant</defName>
    <label>Thunderstorm Ascendant</label>
    <description>The evolved Lightning lineage commands Crimson Sever, Redline Flash, Scarlet Tempest, Sovereign Thunder and Tempest Dragon. Straight zigzag dash chains leave red lightning trails and afterimages. Grants 500% elemental movement, +50 mood, reinforced defense, recovery and Bestow: Lightning. Helmetless white/red regalia and a lightning halo while transformed and drafted. Electrical damage received is reduced by 90%. Damaging electrical hits have a 40% chance to stun a standing hostile for 1.5 seconds, with three seconds of shock recovery.

Damage: this lineage multiplies the Melee damage stat by 2.2 (+120%). The shared 20% reduction makes an otherwise identical eligible physical melee packet 1.76 times its unascended value before armor and other modifiers. This is not a fixed skill-damage value: techniques scale from the current melee profile and use their own multipliers, marks and, where applicable, separate elemental hits. Do not apply the lineage multiplier a second time to the weapon profile.

Teamwork: elemental techniques can synchronize with nearby allied transformed Ascendants for brief shared bonuses and elemental support. Each participant has one six-second support cooldown.</description>
    <comps>
      <li Class="ElementalHearts.HediffCompProperties_LightningRecovery">
        <sealAfterTicks>180</sealAfterTicks>
        <healPerSecond>2</healPerSecond>
      </li>
      <li Class="ElementalHearts.HediffCompProperties_LightningPassives">
        <strikeElectrical>0.5</strikeElectrical>
        <chainChance>0.25</chainChance>
        <chainRadius>4</chainRadius>
        <chainDamageFactor>0.4</chainDamageFactor>
        <chainTargets>3</chainTargets>
        <chainInterval>6</chainInterval>
        <maxCharge>3</maxCharge>
        <chargeDuration>600</chargeDuration>
        <killCooldownReduction>90</killCooldownReduction>
        <dancePerCharge>0.6</dancePerCharge>
        <heavenPerCharge>0.5</heavenPerCharge>
        <counterChance>0.5</counterChance>
        <counterCooldown>120</counterCooldown>
        <resistanceFactor>0.1</resistanceFactor>
        <electricalDamageDefs>
          <li>EH_Lightning</li>
          <li>EMP</li>
          <li>EH_ThunderstormDamage</li>
        </electricalDamageDefs>
      </li>
      <li Class="ElementalHearts.HediffCompProperties_LightningAbilities">
        <severRange>10</severRange>
        <flashRange>15</flashRange>
        <danceRadius>4</danceRadius>
        <heavenRange>12</heavenRange>
        <severCooldown>300</severCooldown>
        <flashCooldown>360</flashCooldown>
        <danceCooldown>540</danceCooldown>
        <heavenCooldown>1350</heavenCooldown>
        <telegraphTicks>12</telegraphTicks>
        <staggerTicks>60</staggerTicks>
        <fistFloor>10</fistFloor>
        <explosionRadius>3</explosionRadius>
        <severPhysical>1.5</severPhysical>
        <severElectrical>0.8</severElectrical>
        <flashPhysical>2</flashPhysical>
        <flashElectrical>1</flashElectrical>
        <dancePhysical>1.5</dancePhysical>
        <danceElectrical>1</danceElectrical>
        <heavenPhysical>6</heavenPhysical>
        <heavenElectrical>4</heavenElectrical>
        <explosionElectrical>1.5</explosionElectrical>
      </li>
      <li Class="ElementalHearts.HediffCompProperties_ThunderstormMastery" />
      <li Class="ElementalHearts.HediffCompProperties_ThunderstormHalo" />
      <li Class="ElementalHearts.HediffCompProperties_TempestCircuit" />
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.2</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.6</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Hearing</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Metabolism</capacity>
            <offset>0.25</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>0.25</offset>
          </li>
          <li>
            <capacity>Eating</capacity>
            <offset>0.25</offset>
          </li>
        </capMods>
        <painFactor>0</painFactor>
        <totalBleedFactor>0.25</totalBleedFactor>
        <naturalHealingFactor>6</naturalHealingFactor>
        <hungerRateFactor>0.6</hungerRateFactor>
        <restFallFactor>0.6</restFallFactor>
        <statFactors>
          <CarryingCapacity>10</CarryingCapacity>
          <MoveSpeed>5</MoveSpeed>
          <MeleeDamageFactor>2.2</MeleeDamageFactor>
          <MeleeCooldownFactor>0.7142857</MeleeCooldownFactor>
          <WorkSpeedGlobal>1.75</WorkSpeedGlobal>
          <IncomingDamageFactor>0.1</IncomingDamageFactor>
          <ImmunityGainSpeed>2</ImmunityGainSpeed>
          <JoyFallRateFactor>0.6</JoyFallRateFactor>

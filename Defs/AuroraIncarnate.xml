<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>EH_AuroraIncarnateUniform</defName>
    <label>Aurora winter-prince regalia</label>
    <description>Indestructible bound midnight suit and ivory split cloak with cyan crystal channels and aurora lining. Complete mechanical protection below the neck; fitted native body textures and west mirroring.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/AuroraIncarnateRegalia/AuroraIncarnateRegalia</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <WorkToMake>3500</WorkToMake>
      <Mass>1.2</Mass>
      <ArmorRating_Sharp>1.25</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.1</ArmorRating_Blunt>
      <Insulation_Cold>90</Insulation_Cold>
      <Insulation_Heat>3</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Hands</li>
        <li>Waist</li>
        <li>Legs</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/AuroraIncarnateRegalia/AuroraIncarnateRegalia</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags Inherit="False">
      </tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    </apparel>
    <generateCommonality>0</generateCommonality>
    <equippedStatOffsets>
      <MoveSpeed>0.15</MoveSpeed>
    </equippedStatOffsets>
    <modExtensions>
      <li Class="ElementalHearts.IndestructibleElementalGear" />
    </modExtensions>
    <useHitPoints>false</useHitPoints>
    <comps>
      <li Class="ElementalHearts.CompProperties_IndestructibleGear" />
    </comps>
    <smeltable>false</smeltable>
    <recipeMaker IsNull="True" />
  </ThingDef>

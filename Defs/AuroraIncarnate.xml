  <HediffDef ParentName="EH_ElementalHeartHediffBase">
    <defName>EH_AuroraIncarnate</defName>
    <label>Aurora Incarnate</label>
    <description>Water → Glacial → Aurora Incarnate. Seven sovereign winter forms combine Rimefall Crescent, Aurora Blitz, Frostcrown Waltz, Aurora Dominion, Aurora Cataclysm, Mirrorfrost Reversal and Throne of Endless Winter. Caster-owned Pressure empowers the same single shatter impact by up to 20%. Cataclysm answers two nearby enemies with safe knockback and a five-second freeze; sovereigns thaw much faster and cannot be chain-frozen. Still Water and Returning Tide remain. Moving 650%, Consciousness 200%, Manipulation 300%, Sight/Hearing 250%, +75 mood, ×3.2 melee stat, ×0.04 incoming damage and rapid recovery. Cold/hypothermia immunity, sovereign carrying/travel benefits and shock resilience. Fitted full below-neck regalia, Winterglass, halo and subtle aurora blade aura. Bestow grants normal Water. Shared Auto/Off/Non-lethal controls; Rime Step/Aurora Travel uses the saved group launch-site system. No terrain, roof, building or climate changes. Damage derives from the current melee profile; shared tuning is applied once.</description>
    <comps>
      <li Class="ElementalHearts.HediffCompProperties_WaterDefense" />
      <li Class="ElementalHearts.HediffCompProperties_LightningRecovery">
        <sealAfterTicks>60</sealAfterTicks>
        <healPerSecond>4</healPerSecond>
      </li>
      <li Class="ElementalHearts.HediffCompProperties_WaterAbilities" />
      <li Class="ElementalHearts.HediffCompProperties_AuroraMastery" />
      <li Class="ElementalHearts.HediffCompProperties_AuroraIncarnate" />
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>5.5</offset>
            <setMax>6.5</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>1.5</offset>
            <setMax>3</setMax>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>1.5</offset>
          </li>
          <li>
            <capacity>Hearing</capacity>
            <offset>1.5</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>1</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>1</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>1</offset>
          </li>
          <li>
            <capacity>Metabolism</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>0.5</offset>
          </li>
          <li>
            <capacity>Eating</capacity>
            <offset>0.5</offset>
          </li>
        </capMods>
        <painFactor>0</painFactor>
        <totalBleedFactor>0.1</totalBleedFactor>
        <naturalHealingFactor>10</naturalHealingFactor>
        <hungerRateFactor>0.6</hungerRateFactor>
        <restFallFactor>0.6</restFallFactor>
        <statFactors>
          <CarryingCapacity>15</CarryingCapacity>
          <MoveSpeed>1.75</MoveSpeed>
          <MeleeDamageFactor>3.2</MeleeDamageFactor>
          <MeleeCooldownFactor>0.55</MeleeCooldownFactor>
          <WorkSpeedGlobal>2</WorkSpeedGlobal>
          <IncomingDamageFactor>0.04</IncomingDamageFactor>
          <ImmunityGainSpeed>2</ImmunityGainSpeed>
          <JoyFallRateFactor>0.6</JoyFallRateFactor>
        </statFactors>
        <statOffsets>
          <MentalBreakThreshold>-0.25</MentalBreakThreshold>
          <MeleeHitChance>4</MeleeHitChance>
          <MeleeDodgeChance>12</MeleeDodgeChance>
          <ComfyTemperatureMin>-250</ComfyTemperatureMin>
          <ComfyTemperatureMax>50</ComfyTemperatureMax>
